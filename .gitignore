# Ignore pickle files
*.pkl
__pycache__/

# Ignore the wandb directory
wandb/
results/
outputs/
model_outputs/

# Ignore other temporary or unnecessary files
*.log
*.tmp

# Ignore generated plots, except curated analysis artifacts under stats/
*.png
!stats/**/*.png

# Raw/derived datasets are too large for a normal git repo (hundreds of MB,
# no LFS configured) -- keep local only. Code, reports, and small stats/
# metadata files stay tracked.
data/*.jsonl
data/full_dataset.json
data/data_split_min5/
data/data_split_fi_eng_min5_abs40/
data/data_f15_abs100_*/
data/data_f20_abs100_*/
data/data_multiuni_2026-07-12/
data/data_multiuni_2026-07-16/

# Demo model package (weights + derived metadata) - regenerated by
# scripts/build_demo_package.py, transferred out-of-band (too large / binary
# for a normal git repo). app.py/README/requirements.txt in demo/ stay tracked.
demo/package/
demo/bundles/
