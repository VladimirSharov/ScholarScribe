# Ignore all .gguf files
*.gguf
*llamafile

# Ignore the model_embedding directory
model_embedding/

# Ignore pickle files
*.pkl
__pycache__/
evaluation_results_*/

# Ignore the wandb directory
wandb/
results/
outputs/
model_outputs/

# Ignore other temporary or unnecessary files
*.log
*.tmp

# Ignore generated plots and output directories
*.png
outputs_2/
outputs_visualizations/
images/

# ...except curated analysis artifacts under boa_strangling/stats/
!boa_strangling/stats/**/*.png

# Raw/derived datasets are too large for a normal git repo (hundreds of MB,
# no LFS configured) -- keep local only. Code, reports, and small stats/
# metadata files under boa_strangling/ are NOT covered by this and stay tracked.
boa_strangling/data/*.jsonl
boa_strangling/data/full_dataset.json
boa_strangling/data/data_split_min5/
boa_strangling/data/data_split_fi_eng_min5_abs40/
boa_strangling/data/data_f15_abs100_*/
boa_strangling/data/data_f20_abs100_*/
boa_strangling/data/data_multiuni_*/
data_split_v4/
data_split_v6/

# Large data / installers that slipped past the rules above and got tracked
# (>100MB, GitHub-rejected). Keep on disk, out of git.
split/
split_freq3/
llama_model/
data_collection/output.json
zdepricated_versions/output_backup.json
Mambaforge-*.sh

# Demo model package (weights + derived metadata) - regenerated by
# boa_strangling/scripts/build_demo_package.py, transferred out-of-band
# (too large / binary for a normal git repo). app.py/README/requirements.txt
# in boa_strangling/demo/ stay tracked.
boa_strangling/demo/package/
boa_strangling/demo/bundles/